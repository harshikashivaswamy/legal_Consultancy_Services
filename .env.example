# =============================================================================
# Legal Consultancy Service — environment variables
# Copy to .env for local work. NEVER commit .env. On AWS, put the SECRET ones in Secrets Manager.
# =============================================================================

# ---- Database (Supabase / Postgres) ----------------------------------------
# PUBLIC values (safe in the browser; baked in at build time -> Docker build args on AWS)
VITE_SUPABASE_URL=https://danvtkudjdphqfzfuonn.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
# SERVER-side copies of the two values above. REQUIRED AT RUNTIME on AWS (Vite only bakes VITE_* into the
# browser bundle; the server code reads these from the container's environment).
SUPABASE_URL=https://danvtkudjdphqfzfuonn.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
# SECRET (server only; Project Settings -> API -> service_role). Needed for OTP storage + admin allowlist.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- OTP security -----------------------------------------------------------
# SECRET: any long random string (e.g. `openssl rand -hex 32`). Used to hash one-time codes.
OTP_HMAC_SECRET=change_me_to_a_long_random_string
# Local development ONLY: print the OTP in the server console when no email is configured.
# Ignored when NODE_ENV=production.
# OTP_DEV_LOG=true

# ---- Email OTP (choose one) -------------------------------------------------
# Option A: Gmail (use a 16-character Google App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=your_gmail_app_password
# Option B: any SMTP server (e.g. Amazon SES SMTP)
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=no-reply@yourdomain.com

# ---- AI assistant (Nyaya AI / TekoraAI) -------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional local fallback:
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2

# ---- Payments (public key only in the browser) ------------------------------
VITE_RAZORPAY_KEY_ID=
# Only used by the legacy dev-only Express server:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ---- Optional SMS OTP (choose one) ------------------------------------------
# FAST2SMS_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1234567890
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# TEXTLOCAL_API_KEY=

# ---- Offline demo mode ------------------------------------------------------
# Demo accounts (no database) work automatically in `npm run dev` when Supabase is NOT configured.
# Do NOT set this on a real deployment.
# VITE_ALLOW_DEMO_AUTH=true
